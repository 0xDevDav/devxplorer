{
  "name": "devxplorer",
  "productName": "DevXplorer",
  "version": "0.1.0",
  "description": "File manager with inline folder previews, ordering and pluggable workflow extensions",
  "author": "0xDevDav",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.devdav.devxplorer",
    "productName": "DevXplorer",
    "copyright": "Copyright © 2026 0xDevDav",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevXplorer",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "it_IT"
      ],
      "artifactName": "DevXplorer-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  }
}
