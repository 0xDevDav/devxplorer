{
  "name": "devxplorer",
  "productName": "DevXplorer",
  "version": "0.3.0",
  "description": "File manager with inline folder previews, ordering and pluggable workflow extensions",
  "author": "0xDevDav",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "electron-builder --win nsis --x64 --publish always"
  },
  "build": {
    "appId": "com.devdav.devxplorer",
    "productName": "DevXplorer",
    "copyright": "Copyright © 2026 0xDevDav",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "package.json",
      "!node_modules/pdfjs-dist/{legacy,types,web,image_decoders,iccs}/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/build/{pdf.mjs,pdf.worker.mjs,pdf.sandbox.mjs,pdf.sandbox.min.mjs}"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevXplorer",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "it_IT"
      ],
      "artifactName": "DevXplorer-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "0xDevDav",
        "repo": "devxplorer"
      }
    ],
    "extraResources": [
      {
        "from": "assets/shellext",
        "to": "shellext"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^6.4.299"
  },
  "homepage": "https://github.com/0xDevDav/devxplorer",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xDevDav/devxplorer.git"
  }
}
